pred_svm <- predict(svm_model, as.matrix(trn[-c(1,2)]), type = "raw")
confusionMatrix(pred_svm, trn$Group, positive = "Disease")
pred_lasso_multinomial <- data.frame(predict(lasso_multinomial$glmnet.fit, newx = as.matrix(trn[-c(1,2)]), s = lasso_multinomial$lambda.1se, type = "class"))
confusionMatrix(as.factor(pred_lasso_multinomial[,1]), trn$Group, positive = "DNML1")
final_model <- cv.glmnet(as.matrix(db_ml[-c(1,2)]), db_ml$Group, family = "multinomial")
final_model$lambda.1se
pred_final_model <- data.frame(predict(final_model$glmnet.fit, newx = as.matrix(db_ml[-c(1,2)]), s = final_model$lambda.1se, type = "class"))
confusionMatrix(as.factor(pred_final_model[,1]), db_ml$Group, positive = "DNML1")
