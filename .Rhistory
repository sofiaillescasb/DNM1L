lasso_multinomial <- cv.glmnet(as.matrix(trn[-c(1,2)]), trn$Group, family = "multinomial")
lasso_multinomial$lambda.1se
pred_lasso_multinomial <- data.frame(round(predict(lasso_multinomial$glmnet.fit, newx = as.matrix(trn[-c(1,2)]), s = lasso_multinomial$lambda.1se, type="response")))
# plot(lasso_multinomial$glmnet.fit, xvar = "lambda", label = TRUE)
confusionMatrix(as.factor(pred_lasso_multinomial[,1]), as.factor(as.numeric(trn$Group)-1), positive = "1")
coef(lasso_multinomial)
