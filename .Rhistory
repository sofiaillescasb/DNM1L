# Re-scale and re-center
original_matrix <- sweep(original_matrix, 2, scale, `*`)
original_matrix <- sweep(original_matrix, 2, center, `+`)
return(as.data.frame(original_matrix))
}
# Get the original feature names (excluding 'Group')
original_feature_names <- names(tst)[-c(1,2)]
# Perform inverse PCA transformation on the grid
grid_original <- inverse_pca(preproc, grid_points)
colnames(grid_original) <- original_feature_names
# Predict class probabilities on the original feature space
grid_original_probs <- predict(svm_model, grid_original, type = "prob")
grid_points$DNM1L_prob <- grid_original_probs[, "DNM1L"]
fig <- plot_ly(pca_transformed, x = ~PC1, y = ~PC2, z = ~PC3, color = ~Group, colors = c('blue', 'red')) %>%
add_markers() %>%
layout(title = '3D Scatter Plot of First 3 Principal Components',
scene = list(xaxis = list(title = 'PC1'),
yaxis = list(title = 'PC2'),
zaxis = list(title = 'PC3')))
# Print the plot
fig
