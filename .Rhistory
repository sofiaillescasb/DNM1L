make_bound_plot(rf_model,trn, 1, 2, "Random Forest")
make_bound_plot(rf_model,trn, 1, 3, "Random Forest")
make_bound_plot(rf_model,trn, 2, 3, "Random Forest")
set.seed(2024)
search_grid <- expand.grid(C = seq(0.01, 2, length = 20))
# Preprocess with PCA and train SVM model
