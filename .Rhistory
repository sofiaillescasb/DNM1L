#     scale_color_manual(values = c("#6996e3", "#dd5129")) +
#     theme_classic() +
#     ggtitle(p)
#   plot(pl)
# }
db %>%
# filter(Group == "Control") %>%
select(-c(ID, Group)) %>%
# select(-c(ID, Group, MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio)) %>%
ggpairs()
# db %>%
#   # filter(Group == "Control") %>%
#   select(c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio)) %>%
#   ggpairs()
red_vars <- redun(as.matrix(db[-c(1,2)]))
db_res <- db %>%
select(c("ID", "Group", red_vars$In))
db_res %>%
select(-c(ID, Group)) %>%
ggpairs()
pca_res <- prcomp(db_res[,-c(1,2)], scale. = TRUE)
autoplot(pca_res, data = db_res, color = "Group", size = 3, loadings = TRUE, loadings.label = TRUE) +
theme_classic() +
scale_color_manual(values = c("#a39b9b",  "#7babdb", "#f2de79"))
autoplot(pca_res, data = db_res, color = "Group", label = TRUE, shape = FALSE, label.label = "ID") +
theme_classic() +
scale_color_manual(values = c("#a39b9b",  "#7babdb", "#f2de79"))
set.seed(2024)
