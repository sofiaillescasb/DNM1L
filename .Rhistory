for (p in colnames(db[-c(1,2)])) {
df <- db[c("ID","Group",p)]
colnames(df) <- c("ID", "Group", "Predictor")
pl <- df %>%
ggplot(aes(sample = Predictor, color = Group)) +
geom_qq() +
geom_qq_line() +
scale_color_manual(values = c("#6996e3", "#dd5129")) +
theme_classic() +
ggtitle(p)
plot(pl)
}
library(here)
library(caret)
library(readxl)
library(ggfortify)
library(GGally)
library(glmnet)
library(tidyverse)
db <- read_excel(here("data/dataform.xlsx"))
db <- na.omit(db)
db$ID <- as.factor(db$ID)
db$Group <- as.factor(db$Group)
# cor(db[,-c(1,2)], method = "pearson")
#
db <- db %>%
pivot_longer(cols = -c(ID, Group), names_to = "Predictor", values_to = "Value") %>%
group_by(ID, Predictor) %>%
summarise( Mean = mean(Value)) %>%
pivot_wider(id_cols = ID, names_from = "Predictor", values_from = "Mean") %>%
mutate(Group = as.factor(ifelse(ID %in% c("20210604", "20210526", "20210409", "20210512", "20220215", "20220411"), "Control", "Disease"))) %>%
select(ID, Group, everything()) %>%
ungroup()
long_db <- db %>%
pivot_longer(cols = -c(ID, Group), names_to = "Predictor", values_to = "Value")
# long_db %>%
#   ggplot(aes(x = ID, y = Value, fill = Group)) +
#   geom_boxplot() +
#   facet_wrap(~ Predictor, scales = "free_y") +
#   scale_fill_manual(values = c("#6996e3", "#dd5129")) +
#   theme_bw()
long_db %>%
ggplot(aes(x = Group, y = Value, fill = Group)) +
geom_boxplot() +
facet_wrap(~ Predictor, scales = "free_y") +
scale_fill_manual(values = c("#6996e3", "#dd5129", "#2b9b81")) +
theme_classic()
long_db %>%
ggplot(aes(x = Value, fill = Group)) +
geom_density(alpha = 0.6) +
facet_wrap(~ Predictor, scales = "free") +
scale_fill_manual(values = c("#6996e3", "#dd5129", "#2b9b81")) +
theme_classic()
long_db %>%
ggplot(aes(x = Value, fill = Group)) +
geom_histogram(alpha = 0.6) +
facet_wrap(~ Predictor, scales = "free") +
scale_fill_manual(values = c("#6996e3", "#dd5129", "#2b9b81")) +
theme_classic()
# for (p in colnames(db[-c(1,2)])) {
#   df <- db[c("ID","Group",p)]
#   colnames(df) <- c("ID", "Group", "Predictor")
#   pl <- df %>%
#     ggplot(aes(sample = Predictor, color = Group)) +
#     geom_qq() +
#     geom_qq_line() +
#     scale_color_manual(values = c("#6996e3", "#dd5129")) +
#     theme_classic() +
#     ggtitle(p)
#   plot(pl)
# }
db %>%
# filter(Group == "Control") %>%
select(-c(ID, Group, MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio)) %>%
ggpairs()
db %>%
# filter(Group == "Control") %>%
select(c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio)) %>%
ggpairs()
pca_res <- prcomp(db[,-c(1,2)], scale. = TRUE)
autoplot(pca_res, data = db, color = "ID", size = 3) +
theme_classic()
autoplot(pca_res, data = db, color = "Group", size = 3, loadings = TRUE, loadings.label = TRUE) +
theme_classic()
autoplot(pca_res, data = db, color = "Group", label = TRUE, shape = FALSE, label.label = "ID") +
theme_classic()
set.seed(2024)
db_ml <- db
# db_ml <- db %>%
#   select(-c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio))
# db_ml <- db %>%
#   select(-c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio))
# trnIndex <- createDataPartition(db_ml$ID, p = 0.7, list = FALSE)
trnIndex <- createDataPartition(db_ml$Group, p = 0.7, list = FALSE)
trn <- db_ml[trnIndex,]
tst <- db_ml[-trnIndex,]
trn[-c(1,2)] <- scale(log2(trn[-c(1,2)]))
tst[-c(1,2)] <- scale(log2(tst[-c(1,2)]))
set.seed(2024)
lasso_multinomial <- cv.glmnet(as.matrix(trn[-c(1,2)]), trn$Group, family = "multinomial")
lasso_multinomial$lambda.1se
pred_lasso_multinomial <- data.frame(predict(lasso_multinomial$glmnet.fit, newx = as.matrix(trn[-c(1,2)]), s = lasso_multinomial$lambda.1se, type = "class"))
# plot(lasso_multinomial$glmnet.fit, xvar = "lambda", label = TRUE)
confusionMatrix(as.factor(pred_lasso_multinomial[,1]), trn$Group, positive = "DNML1")
