install.packages("shinydashboard")
# Chunk 1: setup
library(flexdashboard)
library(here)
library(caret)
library(readxl)
library(ggfortify)
library(GGally)
library(glmnet)
library(Hmisc)
library(plotly)
library(knitr)
library(shiny)
library(tidyverse)
# Install thematic and un-comment for themed static plots (i.e., ggplot2)
# thematic::thematic_rmd()
# Chunk 2
db <- read_excel(here("data/dataform.xlsx"))
db <- na.omit(db)
db$ID <- as.factor(paste0(db$ID, ".", seq(1,length(db$ID))))
db$Group <- as.factor(db$Group)
db <- db %>%
select(-c("MitoCount", "TotArea", "Bcount", "TotPerim", "TotBLength", "Bjunct", "BEndP"))
long_db <- db %>%
pivot_longer(cols = -c(ID, Group), names_to = "Predictor", values_to = "Value")
# Chunk 3
selectInput("geomtype", "Select Plot Type", choices = c("Box plot", "Density plot"), selected = "Box plot")
# Chunk 4
renderPlotly({
plt_type <- reactive(as.character(input$geomtype))
p <- reactive({
if (plt_type() == "Box plot") {
long_db %>%
ggplot(aes(x = Group, y = Value, fill = Group)) +
geom_boxplot() +
facet_wrap(~ Predictor, scales = "free") +
scale_fill_manual(values = c("#a39b9b", "#67c7c5", "#f2de79")) +
theme_classic() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1), legend.position = "none")
} else {
long_db %>%
ggplot(aes(x = Value, fill = Group)) +
geom_density(alpha = 0.6) +
facet_wrap(~ Predictor, scales = "free") +
scale_fill_manual(values = c("#a39b9b", "#67c7c5", "#f2de79")) +
theme_classic()
}
})
ggplotly(p())
})
# Chunk 5
selectInput("corrplot", "Select Plot Type", choices = c("Correlation Matrix", "Hierarchical clustering"), selected = "Correlation Matrix")
# Chunk 6
var_cor <- db %>%
select(-c(ID, Group)) %>%
ggcorr(label = TRUE, low = "#5499C7", high = "#BE0461", size =3)
vclus <- varclus(as.matrix(db[-c(1,2)]))
groups <- cutree(vclus$hclust, 3)
red_vars <- redun(as.matrix(db[-c(1,2)]))
db_res <- db %>%
select(c("ID", "Group", red_vars$In))
# Chunk 7
## Rendering plots based on selected input
uiOutput("corr_plot")
output$corr_plot <- renderUI({
if (input$corrplot == "Correlation Matrix") {
plotlyOutput("plotly_corrplot")
} else {
plotOutput("ggplot_corrplot")
}
})
