tst$Group <- relevel(tst$Group, ref = "Control")
final_cnfmat
make_bound_plot(svm_model, tst,1,2, "SVM")
make_bound_plot(svm_model, tst, 1,3, "SVM")
make_bound_plot(svm_model, tst ,2,3, "SVM")
ggsave(here("plots/des_boun"))
ggsave(here("plots/des_boun.jpeg"))
