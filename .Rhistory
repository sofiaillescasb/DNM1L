db %>%
# filter(Group == "Control") %>%
select(-c(ID, Group, MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio)) %>%
ggpairs()
db %>%
# filter(Group == "Control") %>%
select(c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio)) %>%
ggpairs()
pca_res <- prcomp(db[,-c(1,2)], scale. = TRUE)
# autoplot(pca_res, data = db, color = "ID", size = 3) +
#   theme_classic()
autoplot(pca_res, data = db, color = "Group", size = 3, loadings = TRUE, loadings.label = TRUE) +
theme_classic() +
scale_color_manual(values = c("#6996e3", "#dd5129", "#2b9b81"))
autoplot(pca_res, data = db, color = "Group", label = TRUE, shape = FALSE, label.label = "ID") +
theme_classic() +
scale_color_manual(values = c("#6996e3", "#dd5129", "#2b9b81"))
set.seed(2024)
db_ml <- db
# db_ml <- db %>%
#   select(-c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio))
# db_ml <- db %>%
#   select(-c(MeanArea, MeanPerim, BMitoRatio, TotBLengthMitoRatio, MeanBLength, BJunctMitoRatio, BEndPMitoRatio))
# trnIndex <- createDataPartition(db_ml$ID, p = 0.7, list = FALSE)
trnIndex <- createDataPartition(db_ml$Group, p = 0.7, list = FALSE)
trn <- db_ml[trnIndex,]
tst <- db_ml[-trnIndex,]
trn[-c(1,2)] <- scale(log2(trn[-c(1,2)]))
tst[-c(1,2)] <- scale(log2(tst[-c(1,2)]))
set.seed(2024)
lasso_multinomial <- cv.glmnet(as.matrix(trn[-c(1,2)]), trn$Group, family = "multinomial", maxit = 1000000)
plot(lasso_multinomial$glmnet.fit, xvar = "norm", label = TRUE, type.coef = "2norm")
pred_lasso_multinomial <- data.frame(predict(lasso_multinomial$glmnet.fit, newx = as.matrix(trn[-c(1,2)]), s = lasso_multinomial$lambda.1se, type = "class"))
confusionMatrix(as.factor(pred_lasso_multinomial[,1]), trn$Group, positive = "DNML1")
# lapply(coef(lasso_multinomial))
set.seed(2024)
eln_multinomial <- cv.glmnet(as.matrix(trn[-c(1,2)]), trn$Group, family = "multinomial", alpha = 0.5)
plot(eln_multinomial$glmnet.fit, xvar = "norm", label = TRUE, type.coef = "2norm")
pred_eln_multinomial <- data.frame(predict(eln_multinomial$glmnet.fit, newx = as.matrix(trn[-c(1,2)]), s = eln_multinomial$lambda.1se, type = "class"))
confusionMatrix(as.factor(pred_eln_multinomial[,1]), trn$Group, positive = "DNML1")
coef(eln_multinomial)
set.seed(2024)
library(pROC)
ridge_multinomial <- cv.glmnet(as.matrix(trn[-c(1,2)]), trn$Group, family = "multinomial", alpha = 0)
ridge_multinomial$lambda.1se
plot(ridge_multinomial$glmnet.fit, xvar = "norm", label = TRUE, type.coef = "2norm")
pred_ridge_multinomial <- data.frame(predict(ridge_multinomial$glmnet.fit, newx = as.matrix(trn[-c(1,2)]), s = ridge_multinomial$lambda.1se, type="class"))
confusionMatrix(as.factor(pred_ridge_multinomial[,1]), trn$Group, positive = "DNML1")
coef(ridge_multinomial)
set.seed(2024)
search_grid <- expand.grid(
decay = seq(0, 0.2, by = 0.01)
)
train_control <- trainControl(method="repeatedcv", number=10, repeats=3)
multi_model <- train(Group ~ .,
data = trn[-1],
method = "multinom",
tuneGrid = search_grid,
trControl = train_control)
plot(multi_model)
pred_multi_model <- data.frame(Prediction = predict(multi_model, newx = as.matrix(trn[-c(1,2)]), type="raw"))
trn_class_res <- data.frame(ID = trn$ID, Prediction = pred_multi_model, Reference = trn$Group)
confusionMatrix(predict(multi_model), trn$Group, positive = "DNML1")
varImp(multi_model)
set.seed(2024)
search_grid <- expand.grid(
mtry = seq(1, 10, by = 1)
)
rf_model <- train(Group ~ .,
data = trn[-1],
method = "rf",
tuneGrid = search_grid,
trControl = trainControl(method = "oob"),
ntree = 10000)
plot(rf_model)
varImp(rf_model)
search_grid <- expand.grid(
usekernel = c(TRUE, FALSE),
laplace = c(TRUE, FALSE),
adjust = seq(1, 5, by = 1)
)
train_control <- trainControl(method="repeatedcv", number=10, repeats=3)
nb_model <- train(Group ~ .,
data = trn[-1],
method = "naive_bayes",
trControl = train_control,
# preProcess = c("pca"),
tuneGrid = search_grid)
plot(nb_model)
pred_gnb <- predict(nb_model, as.matrix(trn[-c(1,2)]), type = "raw")
confusionMatrix(pred_gnb, trn$Group, positive = "DNM1L")
set.seed(2024)
train_control <- trainControl(method="repeatedcv", number=10, repeats=3)
svm_model <-  train(Group ~ .,
data = trn[-1],
# preProcess = c("pca"),
trControl = train_control,
method = "svmLinear3")
plot(svm_model)
pred_svm <- predict(svm_model, as.matrix(trn[-c(1,2)]), type = "raw")
confusionMatrix(pred_svm, trn$Group, positive = "DNM1L")
pred_multinomial <- predict(multi_model, as.matrix(tst[-c(1,2)]))
confusionMatrix(pred_multinomial, tst$Group, positive = "DNML1")
tst_class_res <- data.frame(ID = tst$ID, Prediction = pred_multinomial, Reference = tst$Group)
