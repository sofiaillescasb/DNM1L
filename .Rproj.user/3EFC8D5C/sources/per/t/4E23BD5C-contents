library(caret)
library(gglasso)
library(glmnet)
library(impute)
library(tidyverse)
```


```{r data_imports}

# First I read all the sheets in the Excel file containing my lipidommics dataset

path <- here("data_raw/P21145_Results_final.xlsx")

sheets_to_keep <- c("Lip-I","Lip-II")

db <- path %>% 
  excel_sheets() %>% 
  set_names() %>% 
  map(read_excel, path = path)

# Now I need the metadata file containing the patients' diseases, ages, etc.

metdat <- read_delim(here("metadata/metdat.csv"),delim=";",show_col_types = FALSE)

# The rosetta stone the lab used for carnitines is necessary because they are apparently insane and can't be bothered to just name them that in the Excel file

carnitine_translation <- read_tsv(here("metadata/acylcarnitines.txt"), col_names = FALSE, show_col_types = FALSE)

colnames(carnitine_translation) <- c("Input","Converted")
carnitine_translation_vector <- setNames(carnitine_translation$Converted, carnitine_translation$Input)
```


```{r getting_data_and_fixing_names, message=FALSE}

carnitines <- db$`Tryptophan & metabolites` %>%
  dplyr::select(contains(c("COS Code","(Carn)"))) 

colnames(carnitines) <- colnames(carnitines) %>%
  str_remove_all("\\(Carn\\)") %>%
  str_trim()

colnames(carnitines) <- ifelse(colnames(carnitines)%in%names(carnitine_translation_vector),carnitine_translation_vector[colnames(carnitines)],colnames(carnitines))

lipidomics_db <- full_join(db$`Lip-I`,db$`Lip-II`)
lipidomics_db <- full_join(lipidomics_db,carnitines)

lipidomics_db <- lipidomics_db %>% 
  dplyr::filter(str_detect(`COS Code`,"CSF"))

lipidomics_db <- lipidomics_db %>%
  mutate(across('COS Code', function(x) str_replace(x," ", "."))) %>%
  column_to_rownames('COS Code')

```

I'll add up the concentrations of lipids that are stereoisomers because I don't care about that.

```{r data_aggregation, message=FALSE}

consolidated_lipidomics_db_long <- lipidomics_db %>%
  rownames_to_column(var="ID") %>%
  pivot_longer(!ID, names_to = "Lipid", values_to = "Concentration") %>%
  mutate(Lipid=str_remove_all(Lipid, "-sn[123]|-iso[123]|-.sn[123]|[()]")) %>%
  group_by(ID, Lipid) %>%
  summarize(Concentration = sum(Concentration))

consolidated_lipidomics_db <- consolidated_lipidomics_db_long %>%
  pivot_wider(id_cols = ID, names_from = Lipid, values_from = "Concentration") %>%
  column_to_rownames(var="ID")

colnames(consolidated_lipidomics_db) <- str_replace(colnames(consolidated_lipidomics_db),"ChoE","CE")

```


```{r removing_missing_columns}
total_case_size <- length(rownames(consolidated_lipidomics_db))

lipidomics_db_pre_imput <- consolidated_lipidomics_db %>%
  dplyr::select_if(~ sum(is.na(.)) <= 0.2*total_case_size) %>%
  rownames_to_column("ID")
```


```{r adding_labels, message=FALSE}

descriptive_ids <- setNames(metdat$ID,metdat$`COS Code`)

lipidomics_db_pre_imput$ID <- ifelse(lipidomics_db_pre_imput$ID%in%names(descriptive_ids),descriptive_ids[lipidomics_db_pre_imput$ID],
                                     lipidomics_db_pre_imput$ID)

group_labels <- metdat %>%
  dplyr::select(ID, Gene) 
  

lipidomics_db_labeled <- lipidomics_db_pre_imput %>%
  left_join(group_labels, by="ID") %>%
  mutate(Group = ifelse(Gene == "Control", "Control", "Patient")) %>%
  mutate(across(c(Group, Gene), as.factor)) %>%
  mutate(across(c(Group, Gene), ~ relevel(.x, "Control"))) %>%
  filter(Gene %in% c("GRIN", "STXBP1", "MeCP2", "CDKL5", "Control")) %>%
  select(ID, Group, Gene, everything())

colnames(lipidomics_db_labeled) <- (str_replace(colnames(lipidomics_db_labeled), "LCA-S", "LCA"))

```


```{r}

lipidomics_db_labeled_long <- lipidomics_db_labeled %>%
  pivot_longer(!c(ID, Group, Gene), names_to = "Lipid", values_to = "Concentration") 

refmet.results <- read_tsv(here("metadata/refmet_results.txt"),show_col_types = FALSE)

lipidomics_db_labeled_classed <- refmet.results %>%
  dplyr::select(`Input name`,`Sub class`) %>%
  dplyr::rename(Lipid=`Input name`, Class=`Sub class`) %>%
  right_join(lipidomics_db_labeled_long, by="Lipid")  %>%
  mutate(across(where(is.character),as.factor)) %>%
  mutate(Gene=relevel(Gene, "Control"))

lipidomics_db_classed_agg <- lipidomics_db_labeled_classed %>%
  group_by(ID,Class) %>%
  mutate(Per_class=sum(Concentration)) %>%
  ungroup() %>%
  select(-c(Lipid, Concentration)) %>%
  distinct() %>%
  select(ID, Group, Gene, Class, Per_class)

```



```{r split_data}

for_ml <- lipidomics_db_classed_agg %>%
  pivot_wider(id_cols = c(ID,Group,Gene), names_from = "Class", values_from = "Per_class") %>%
  column_to_rownames("ID")
  
set.seed(2024)

trnIndex <- createDataPartition(for_ml$Group, p = 0.7, list = FALSE)

trn <- for_ml[trnIndex,]
```


```{r naive_bayes}

search_grid <- expand.grid(
  usekernel = c(TRUE, FALSE),
  laplace = c(TRUE, FALSE),
  adjust = seq(1, 5, by = 1)
)


cv_gnb <- caret::train(as.matrix(trn[,-c(1,2)]), 
                       trn$Group,
                       method="naive_bayes",
                       preProcess = c("knnImpute"),
                       tuneGrid = search_grid,
                       trControl = trainControl(method = "LOOCV"),
                       metric = "Kappa"
             )



pred_gnb <- predict(cv_gnb, as.matrix(trn[-c(1,2)]), type = "raw")
confusionMatrix(pred_gnb, trn$Group)

varImp(cv_gnb)
plot(cv_gnb)

tst <- for_ml[-trnIndex,]

pred_gnb_tst <- predict(cv_gnb, as.matrix(tst[-c(1,2)]), type = "raw")
confusionMatrix(pred_gnb_tst, tst$Group)

set.seed(2024)

trn.lasso <- trn 

#WTF THIS ACTUALLY WORKED????

num_class <- as.data.frame(sapply(trn.lasso[c(1,2)], as.numeric))

lasso_mgaussian <- cv.glmnet(as.matrix(trn.lasso[-c(1,2)]), as.matrix(num_class), family = "mgaussian")
lasso_mgaussian$lambda.1se

pred_lasso_mgaussian <- data.frame(round(predict(lasso_mgaussian$glmnet.fit, newx = as.matrix(trn.lasso[-c(1,2)]), s = lasso_mgaussian$lambda.1se)))

plot(lasso_mgaussian$glmnet.fit, xvar = "lambda", label = TRUE, type.coef = "2norm")

confusionMatrix(as.factor(pred_lasso_mgaussian[,1]), as.factor(num_class$Group))

coef(lasso_mgaussian)

pred_lasso_mgaussian$Group.1
```

